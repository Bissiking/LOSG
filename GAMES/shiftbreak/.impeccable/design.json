  "narrative": {
    "northStar": "Le rail vivant",
    "overview": "Une piste géométrique sur fond d’encre, où chaque signe explique une action ou un état. La silhouette fendue du joueur et les rails forment l’identité du jeu ; la typographie structure les commandes sans concurrencer la lecture du parcours. L’interface française est directe, calme et compacte.\n\nLe jeu privilégie l’expérience pendant la course et la manipulation explicite dans les panneaux. Le parcours reste visible à côté du menu sur grand écran ; pendant la partie, le panneau disparaît. L’univers est dessiné en Canvas 2D, sans illustration rapportée. Ce document décrit le prototype construit ; il ne définit ni nouveaux écrans ni fonctionnalités futures.",
    "keyCharacteristics": [
      "Une géométrie originale, avec une silhouette de joueur immédiatement identifiable.",
      "Une couleur liée à une fonction, renforcée par une forme, une trame ou un libellé.",
      "Une interface sobre autour du parcours, avec des mesures réelles et des commandes visibles.",
      "Des effets discrets qui accompagnent l’inversion sans masquer les obstacles."
    ],
    "rules": [
      {
        "name": "The Signal Rule",
        "body": "Chaque couleur de jeu garde son rôle ; les obstacles utilisent aussi hachures, pointillés ou mots pour communiquer leur état.",
        "section": "colors"
      },
      {
        "name": "The Measurement Rule",
        "body": "La chasse fixe appartient aux mesures et aux repères d’entrée ; les explications restent en Manrope.",
        "section": "typography"
      },
      {
        "name": "The Clear Track Rule",
        "body": "Pendant la course, le panneau disparaît et les effets ne recouvrent pas durablement les obstacles.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** conserver la menthe pour le joueur, la gravité, la progression et l’action principale.",
      "**Do** renforcer les dangers et états temporaires par une trame, un trait ou un libellé.",
      "**Do** retirer le panneau pendant la course et garder les commandes accessibles autour de la piste.",
      "**Do** conserver les unités, les chiffres tabulaires et les messages de session temporaire.",
      "**Do** adapter les panneaux et les rangées de commandes à la largeur disponible."
    ],
    "donts": [
      "**Don't** ajouter des effets qui masquent la géométrie utile ou forcer l’anneau en mouvement réduit.",
      "**Don't** transformer les mesures du parcours en grille décorative.",
      "**Don't** substituer une illustration à la géométrie originale du prototype.",
      "**Don't** introduire un vocabulaire visuel de compte, sauvegarde, classement ou progression persistante."
    ]
  }
}

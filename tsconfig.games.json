{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@arcline/shared": ["GAMES/arcline/packages/shared/src/index.ts"] }
  },
  "include": ["play", "scripts/*.ts", "vite.config.ts", "GAMES/*/src", "GAMES/arcline/apps/client/src", "GAMES/arcline/packages/shared/src", "GAMES/Fouria/server.ts"],
  "exclude": ["**/*.test.ts"]
}
